# Template only. Never store real values in version control.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=REPLACE_IN_LOCAL_UNTRACKED_ENV
DATABASE_URL=postgresql://anima:anima_dev_only@localhost:5432/anima_dev
REDIS_URL=redis://localhost:6379/0
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=mock
MEDIA_PROVIDER=local
CLOUDFLARE_R2_BUCKET=anima-dev
STREAM_ENABLED=false
POSTHOG_ENABLED=false
SENTRY_ENABLED=false
# Protected credentials belong in local .env files / cloud secret manager, not here.

# Local storage permitted only with DEBUG=true. Production uses PRIVATE R2 buckets.
MEDIA_STORAGE_BACKEND=local
PRIVATE_MEDIA_ROOT=.anima-private-media
R2_ENDPOINT_URL=
R2_BUCKET_PHOTOS=
R2_BUCKET_EVIDENCE=
# Never commit R2_ACCESS_KEY_ID or R2_SECRET_ACCESS_KEY values.

# Cloudflare Stream playback host, not an API token. Blank disables video feed.
# Example: videodelivery.net
VIDEO_DELIVERY_HOST=

# Direct creator video uploads are OFF until a Stream account and signed webhook
# are configured. Never commit account credentials or signing secret.
STREAM_UPLOADS_ENABLED=false
STREAM_ACCOUNT_ID=
STREAM_API_TOKEN=
STREAM_WEBHOOK_SECRET=

# Additional explicit gate; never switch on before human moderation, provider
# identity controls and takedown/retry operations are ready.
STREAM_PUBLICATION_ENABLED=false
